{
  "info": {
    "name": "Sistema General - Validacion HTTP y JSON",
    "description": "Pruebas de contrato para los endpoints JSON principales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost/sistema-general-main/sistema-general-main"
    }
  ],
  "item": [
    {
      "name": "200 - Obtener frutas",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/includes/obtener_frutas.php"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Content-Type JSON', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "const body = pm.response.json();",
              "pm.test('Formato de exito valido', function () {",
              "    pm.expect(body.exito).to.eql(true);",
              "    pm.expect(body).to.have.property('mensaje');",
              "    pm.expect(body.datos).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "400 - Perfil sin autenticacion",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/includes/procesar_perfil.php?accion=actualizar"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado HTTP 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('Content-Type JSON', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "const body = pm.response.json();",
              "pm.test('Formato de error valido', function () {",
              "    pm.expect(body.exito).to.eql(false);",
              "    pm.expect(body.mensaje).to.eql('No estás logueado');",
              "    pm.expect(body.datos).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "500 - Error de base de datos (ejecutar con MySQL detenido)",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Para probarla, renombra temporalmente la tabla frutas en la base taf2 (por ejemplo, frutas_prueba) y ejecuta la solicitud. Restáurala después de la prueba.",
        "url": "{{baseUrl}}/includes/obtener_frutas.php"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado HTTP 500', function () {",
              "    pm.response.to.have.status(500);",
              "});",
              "pm.test('Content-Type JSON', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "const body = pm.response.json();",
              "pm.test('Formato de error interno valido', function () {",
              "    pm.expect(body.exito).to.eql(false);",
              "    pm.expect(body.mensaje).to.be.a('string');",
              "    pm.expect(body.datos).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
